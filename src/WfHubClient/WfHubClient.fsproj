<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Domain.fs" />
    <Compile Include="Api.fs" />
    <Compile Include="Protocol.fs" />
    <Compile Include="Licenses.fs" />
    <Compile Include="Requirements.fs" />
    <Compile Include="Readiness.fs" />
    <Compile Include="Pack.fs" />
    <Compile Include="Client.fs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WfHubClient.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ARCtrl" Version="[3.3.1]" />
    <!-- ARCtrl 3.3.1 needs FSharp.Core 10.1.302 or newer. Older .NET 10 SDK bands bring an older
         implicit FSharp.Core, and restore then warns about the downgrade (NU1605). -->
    <PackageReference Update="FSharp.Core" Version="10.1.302" />
  </ItemGroup>

</Project>
