# Settings for the mock badge test instance. Copy this file to mock.env and fill in the token.
# Never commit mock.env.

# Base URL of the endpoint submission service. The compose network name works inside Docker.
MOCK_HOOK_BASE_URL=http://endpointsubmissionservice:8080

# GitLab project of the ARC on the DataHUB.
MOCK_PROJECT_ID=45

# GitLab path_with_namespace sent as project_name.
MOCK_PROJECT_NAME=Facultative-CAM-in-Talinum-Test

# RO-Crate metadata URL sent as ro_crate_url. The page also derives the DataHUB host from it.
MOCK_RO_CRATE_URL=https://gitdev.nfdi4plants.org/api/v4/projects/45/packages/generic/isa_arc_json/0.0.1/arc-ro-crate-metadata.json

# Your own short-lived DataHUB token with the read_api and read_repository scopes (the service checks the ARC out with git).
# Put it only into mock.env, which git ignores. Revoke it after testing.
MOCK_DATAHUB_PAT=

# Target environment. Optional, defaults to sandbox. Only sandbox is accepted, because this test instance never targets production.
MOCK_TARGET=sandbox

# Shared secret sent as the X-Hook-Secret header. Optional, only needed when the service does not run in Development.
MOCK_HOOK_SECRET=
