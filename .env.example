# ASP.NET Core hosting. Development selects the DI authenticator that accepts hooks without
# X-Hook-Secret; use a non-Development value for deployments that require shared-secret auth.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080

# Database used by EndpointSubmission.Service.
PostgresConnectionString=Host=submission_db;Port=5432;Database=endpoint_submission;Username=postgres;Password=postgres

# Only listed DataHUB hosts may be fetched. Add further entries with consecutive indices.
EndpointSubmission__AllowedDataHubHosts__0=gitdev.nfdi4plants.org

# Production submission is irreversible. Keep this false in local development.
EndpointSubmission__AllowProductionTarget=false

# Public origin used when constructing follow_me URLs.
EndpointSubmission__PublicBaseUrl=http://localhost:8081

# Maximum accepted age of a hook envelope's iat value.
EndpointSubmission__HookMaxAgeSeconds=300

# Required outside Development. Leave empty when using the development authenticator.
EndpointSubmission__HookSharedSecret=
