# ASP.NET Core hosting. Development selects the DI authenticator that accepts hooks without
# X-Hook-Secret; use a non-Development value for deployments that require shared-secret auth.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080

# Database used by EndpointSubmission.Service.
PostgresConnectionString=Host=submission_db;Port=5432;Database=endpoint_submission;Username=postgres;Password=postgres

# Only listed DataHUB hosts may be fetched. Add further entries with consecutive indices.
EndpointSubmission__AllowedDataHubHosts__0=gitdev.nfdi4plants.org

# Production submission is irreversible. Keep this false in local development.
EndpointSubmission__AllowProductionTarget=false

# Public origin of follow_me URLs and of the WorkflowHub OAuth callback. The callback needs https,
# and the mock badge test instance serves https on this port, so set https://localhost:8081 when you
# use it (testing/mock-badge/README.md).
EndpointSubmission__PublicBaseUrl=http://localhost:8081

# Maximum accepted age of a hook envelope's iat value.
EndpointSubmission__HookMaxAgeSeconds=300

# Required outside Development. Leave empty when using the development authenticator.
EndpointSubmission__HookSharedSecret=

# Seconds the ARC checkout may take (1 to 3600). Packing then runs to the end, usually in seconds,
# so the WorkflowHub hook can answer somewhat later than this limit.
# WorkflowHub__PreparationTimeoutSeconds=180

# WorkflowHub login. Register a public (non-confidential) OAuth application on the WorkflowHub
# instance under My Profile, Actions, API Applications. Use the redirect URI
# {EndpointSubmission__PublicBaseUrl}/workflowhub/oauth/callback and the scopes read and write.
# Put the UID of the application here. The service needs no client secret.
WorkflowHub__Sandbox__ClientId=
# WorkflowHub__Production__ClientId=
# Minutes a started OAuth login stays valid.
# WorkflowHub__OAuthFlowMinutes=10
